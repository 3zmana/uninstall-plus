<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Uninstall Plus</vendor>
  <icon_name>io.github._3zmana.UninstallPlus</icon_name>

  <!-- Run the privileged helper that removes packages and edits repositories. -->
  <action id="io.github._3zmana.UninstallPlus.helper">
    <description>Manage installed software and repositories</description>
    <description xml:lang="fr">Gérer les logiciels installés et les dépôts</description>
    <message>Authentication is required to uninstall software or change repositories</message>
    <message xml:lang="fr">Une authentification est nécessaire pour désinstaller des logiciels ou modifier les dépôts</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <!-- Keep the authorization for a few minutes so that the removal preview
           and the removal itself only ask for the password once. -->
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/uninstall-plus/uninstall-plus-helper</annotate>
  </action>
</policyconfig>
